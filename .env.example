# Copy to .env.local and fill in. Never commit real keys.

# Supabase project — create at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# MapTiler — free tier at https://www.maptiler.com/cloud/
# If unset, the map falls back to the MapLibre demo style (low-detail).
NEXT_PUBLIC_MAPTILER_KEY=

# Resend — for nightly match emails (Phase 2). Get a key at https://resend.com
RESEND_API_KEY=
